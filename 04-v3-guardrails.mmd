    classDef errorStyle fill:#FFEBE6,stroke:#DE350B,color:#172B4D
    classDef warnStyle fill:#FFFAE6,stroke:#FF8B00,color:#172B4D

    class Gate1,Gate2 gateStyle
    class PipelineGuards,AG1,AG2,AG3,AG4,AG5 agentStyle
    class G1A,G1B,G1C,OG1,OG2,OG3,OG4,OG5 processStyle
    class SafeAnswer successStyle
    class Refused,SecurityAlert,HardBlock,ScopeBlock,HardBoundsBlock errorStyle
    class Repair,Narrow,WarnAnswer warnStyle
    class RunQuery processStyle
    class Incoming successStyle
