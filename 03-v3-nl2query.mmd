    classDef errorStyle fill:#FFEBE6,stroke:#DE350B,color:#172B4D
    classDef infraStyle fill:#F4F5F7,stroke:#6B778C,color:#172B4D
    classDef userStyle fill:#E3FCEF,stroke:#00875A,color:#172B4D

